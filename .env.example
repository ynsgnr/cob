# Copy to .env (gitignored). Never commit real values.
PORT=3000
# Where downloaded videos are stored (<MEDIA_DIR>/<platform>/<id>/video.mp4).
MEDIA_DIR=./data/media
DATABASE_PATH=./data/cob.db
# Wyoming whisper server, e.g. tcp://wyoming-whisper:10300. Unset = no transcription.
WYOMING_URL=
# Optional language hint for whisper (e.g. en). Empty = server default.
WHISPER_LANGUAGE=
# Netscape cookies.txt for yt-dlp (Instagram usually needs a logged-in session). Copied per run, never modified.
YTDLP_COOKIES_FILE=
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
# Use the platform's own captions instead of transcribing: off | manual (human subtitles only) | auto (default: human
# subtitles, else the original-language auto-generated captions). The language is WHISPER_LANGUAGE, default en.
# Platforms without captions (Instagram) always go to Whisper, and so does anything where the caption request fails.
SUBTITLES=
# Pause between downloads in ms (default 5000), to stay under platform rate limits.
JOB_GAP_MS=

# Karakeep integration, on when KARAKEEP_API_KEY is set (then the other two are required).
# New Karakeep links a provider understands are archived here, and a bookmark to their /k/<id> page is added.
KARAKEEP_API_KEY=
KARAKEEP_URL=
# Optional host rules, as bare hostnames. A PUBLIC host may only GET /k/<id> and /media/<id> (everything else is 404);
# the INTERNAL host may do everything. With INTERNAL_HOST set, every other host is treated as public.
# With only PUBLIC_HOST set, other hosts are unrestricted. With neither, nothing is restricted (put your own proxy in front).
PUBLIC_HOST=
INTERNAL_HOST=
# Public address of this app as Karakeep (and you) reach it, no trailing slash.
PUBLIC_BASE_URL=
# Poll interval in ms (default 60000). KARAKEEP_BACKFILL=true also converts links that existed before the first run.
KARAKEEP_POLL_MS=
KARAKEEP_BACKFILL=
# true = also delete the original bookmark once the Cob one exists. Anything else keeps both (default).
KARAKEEP_REPLACE=
